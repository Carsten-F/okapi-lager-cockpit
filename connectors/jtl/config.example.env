# Nach /etc/lager-cockpit/jtl.env kopieren, Modus 600, Eigentuemer root. NIE ins Repository oder in den Chat.
JTL_HOST=
JTL_PORT=1433
JTL_DB=eazybusiness
JTL_USER=
JTL_PASSWORD=
# Bei aelteren SQL-Server-Versionen ggf. 7.3 oder 7.2
JTL_TDS_VERSION=7.4
JTL_QUERY_TIMEOUT=600
# Ziele (Schreiben ueber psql im Datenbank-Container)
PSQL_MAIN="docker exec -i supabase-db psql -U postgres -d postgres"
PSQL_PII="docker exec -i supabase-db psql -U postgres -d okapi_kunden"

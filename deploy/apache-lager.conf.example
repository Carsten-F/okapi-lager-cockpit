# Vorlage: Web-Interface unter https://supabase.okapi-online.de/lager/ ausliefern.
# In die bestehende Datei /etc/apache2/sites-available/021-supabase.okapi-online.de.conf im
# <VirtualHost *:443>-Block einfuegen, VOR die ProxyPass-Zeile fuer "/" (Reihenfolge zaehlt).
# Erst nach Sicht auf die vorhandene Datei anpassen. Danach:
#   apachectl configtest && systemctl reload apache2     # reload ist unterbrechungsfrei
# Benoetigt mod_headers und mod_alias:  a2enmod headers alias
# Der Apache bedient auch die Shops (sanoanimal.*): nie restart, nur configtest + reload.

Alias /lager /opt/lager-cockpit/web
<Directory /opt/lager-cockpit/web>
    Require all granted
    Options -Indexes
    AllowOverride None
    Header always set Cache-Control "no-cache"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</Directory>
# /lager nicht an Supabase (Envoy) weiterreichen:
ProxyPass /lager !
